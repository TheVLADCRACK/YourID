# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/yourid?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=yourid

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://:YOUR_REDIS_PASSWORD@redis:6379"
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

APP_URL=http://YOUR_SERVER_IP:3000
API_URL=http://YOUR_SERVER_IP:4000

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_string_here_abc123
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_another_random_string_xyz789
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Webhook ────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=CHANGE_ME_webhook_secret_string

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=yourid-files
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Your ID <noreply@yourid.com>

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Business Logic ─────────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=15

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://YOUR_SERVER_IP:3000
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:4000/api/v1