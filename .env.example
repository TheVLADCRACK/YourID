# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── Base de données SQLite ───────────────────────────────────────────────────
DATABASE_PATH=./data/yourid.db

# ─── Uploads (images locales : cover, logo, bannière, avatar) ────────────────
UPLOAD_DIR=./uploads
# En production Hostinger, chemin absolu recommandé :
# UPLOAD_DIR=/home/user/yourid/uploads

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGEZ_MOI_min_32_caracteres_aleatoires
JWT_REFRESH_SECRET=CHANGEZ_MOI_min_32_caracteres_autre_chaine
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Sécurité webhook (completion commandes) ─────────────────────────────────
WEBHOOK_SECRET=CHANGEZ_MOI_secret_webhook

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Your ID <noreply@votredomaine.com>

# ─── IA OpenAI (optionnel — génération descriptions) ─────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ─── Commission plateforme ────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=15

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
