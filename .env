# Minimal environment for local docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yourid
REDIS_PASSWORD=redis

# App-level env used by apps/api and apps/web
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/yourid?schema=public
REDIS_URL=redis://:redis@redis:6379
APP_URL=http://localhost:3000
PORT=4000
NODE_ENV=development

# Minimal JWT secrets for local development (replace for production)
JWT_ACCESS_SECRET=dev-access-secret-which-is-at-least-32-chars!
JWT_REFRESH_SECRET=dev-refresh-secret-which-is-at-least-32-chars!

# Optional API keys (set real values if using these services locally)
RESEND_API_KEY=re_btghXAd8_CbsCGbfXUxs8LxqmEYFy8jeV
OPENAI_API_KEY=
